{
  "name": "tree-sitter-fsharp",
  "version": "0.3.13",
  "description": "F# grammars (implementation and signature files) for tree-sitter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ionide/tree-sitter-fsharp.git"
  },
  "license": "MIT",
  "author": "Nikolaj Sidorenco",
  "main": "bindings/node",
  "types": "bindings/node",
  "files": [
    "binding.gyp",
    "bindings/node/*",
    "prebuilds/**",
    "common/**",
    "fsharp/src/**",
    "fsharp_signature/src/**",
    "fsharp_signature/queries/*",
    "queries/*",
    "*.wasm"
  ],
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-config-google": "^0.14.0",
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.27.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prepack": "node scripts/npm-readme.js swap",
    "postpack": "node scripts/npm-readme.js restore",
    "generate": "tree-sitter generate --output fsharp/src fsharp/grammar.js && tree-sitter generate --output fsharp_signature/src fsharp_signature/grammar.js",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "check:invalid": "dotnet fsi scripts/check-fsc-detected.fsx",
    "check:baseline": "dotnet fsi scripts/check-parse-baseline.fsx",
    "check:highlights": "bash scripts/highlight-coverage.sh --check",
    "lint": "eslint fsharp/grammar.js fsharp_signature/grammar.js",
    "test": "node --test bindings/node/*_test.js"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  }
}
